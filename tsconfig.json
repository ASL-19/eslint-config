{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "declaration": true,
    "exactOptionalPropertyTypes": true,
    "module": "nodenext",
    "noImplicitAny": false,
    "noUncheckedIndexedAccess": true,
    "outDir": "types",
    "strict": true,
    "target": "es2022",
    "types": [
      "node"
    ]
  },
  "include": [
    "*.js",
    "*.ts",
    "configs/**/*.js",
    "tests/**/*.ts"
  ],
  "exclude": [
    "tests/fixtures"
  ]
}
