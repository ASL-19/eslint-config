{
  "name": "@asl-19/eslint-config",
  "version": "1.0.0",
  "description": "Shared ESLint config for ASL19 projects",
  "author": {
    "name": "Grant Heaslip",
    "email": "grant@asl19.org",
    "url": "https://asl19.org/"
  },
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ASL-19/eslint-config.git"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    "types": "./types/index.d.ts",
    "default": "./index.js"
  },
  "files": [
    "configs/**/*.js",
    "types/**/*.d.ts",
    "index.js"
  ],
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=11.17.0",
      "onFail": "error"
    },
    "runtime": {
      "name": "node",
      "version": "24.x",
      "onFail": "error"
    }
  },
  "scripts": {
    "build": "rm -rf types && tsc --project tsconfig-dist.json",
    "build-lint-test": "run-s build lint-test",
    "dev-lint-test": "npm install --no-audit && npm run lint-test",
    "eslint-check": "eslint .",
    "eslint-fix": "eslint . --fix",
    "lint-test": "run-p -l tsc-check eslint-check prettier-check vitest-check publint-check attw-check",
    "mise-outdated": "mise outdated --local",
    "npm-outdated": "npm outdated || true",
    "outdated": "run-s -c -l mise-outdated npm-outdated pinact-outdated",
    "pinact-outdated": "pinact run --update --check --min-age 7 || true",
    "pinact-update": "pinact run --update --min-age 7",
    "prepublishOnly": "npm run build-lint-test",
    "prettier-check": "prettier --check .",
    "prettier-fix": "prettier --write .",
    "publint-check": "publint",
    "test": "vitest",
    "tsc-check": "tsc --noEmit",
    "vitest-check": "vitest run",
    "attw-check": "attw --pack . --profile esm-only"
  },
  "dependencies": {
    "@eslint-react/eslint-plugin": "^5.26.5",
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "eslint-plugin-perfectionist": "^5.12.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-security": "^4.2.0",
    "globals": "^17.13.0",
    "typescript-eslint": "^8.71.2"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "^24.19.2",
    "eslint": "^10.12.0",
    "npm-run-all2": "^9.0.3",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "typescript": "~6.0.3",
    "vitest": "^5.0.4"
  },
  "peerDependencies": {
    "eslint": "^10.12.0"
  },
  "allowScripts": {
    "fsevents": false
  }
}
